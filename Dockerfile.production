# Production Dockerfile for Lucky v2 - External Model Loading
# This version expects the model to be provided externally (volume, configmap, etc.)

# Build stage
FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app

# Copy dependency files
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o classifier ./cmd/server

# Production stage - distroless for security
FROM gcr.io/distroless/static-debian11:nonroot

WORKDIR /app

# Copy only the binary
COPY --from=builder /app/classifier ./

# Use nonroot user (uid 65532)
USER 65532:65532

# Expose port
EXPOSE 8080

# Default command - model path should be provided via environment or volume
ENTRYPOINT ["./classifier"]
CMD ["-port=8080"]
